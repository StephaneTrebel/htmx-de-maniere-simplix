package templates

// TagsSidebar est le fragment HTML du sidebar "Popular Tags".
// Il remplace le composant Preact PopularTags côté serveur.
//
// Au clic sur un tag, un événement DOM custom "conduit:tag" est dispatché.
// Le composant Home.tsx Preact restant écoute cet événement pour mettre à jour
// le fil d'articles — c'est le seul point de communication entre le HTML Go et le JS Preact.
templ TagsSidebar(tags []string) {
	<div class="sidebar">
		<p>Popular Tags</p>
		<div class="tag-list">
			for _, tag := range tags {
				<a
					class="tag-pill tag-default"
					href="#"
					data-tag={ tag }
					onclick="event.preventDefault(); document.dispatchEvent(new CustomEvent('conduit:tag', { bubbles: true, detail: this.dataset.tag }))"
				>{ tag }</a>
			}
		</div>
	</div>
}
