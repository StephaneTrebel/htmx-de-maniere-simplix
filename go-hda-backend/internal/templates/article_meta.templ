package templates

import (
	"conduit-hda/internal/api"
	"fmt"
	"net/url"
	"strconv"
)

templ ArticleMeta(article api.Article, slot string, currentUsername string) {
	<conduit-article-meta id={ articleMetaID(slot) } data-slot={ slot }>
		@articleMetaContent(article, slot, currentUsername)
	</conduit-article-meta>
}

templ ArticleMetaOOB(article api.Article, slot string, currentUsername string) {
	<conduit-article-meta id={ articleMetaID(slot) } data-slot={ slot } hx-swap-oob="true">
		@articleMetaContent(article, slot, currentUsername)
	</conduit-article-meta>
}

templ ArticleMetaPair(article api.Article, activeSlot string, currentUsername string) {
	@ArticleMeta(article, activeSlot, currentUsername)
	@ArticleMetaOOB(article, otherArticleMetaSlot(activeSlot), currentUsername)
}

templ articleMetaContent(article api.Article, slot string, currentUsername string) {
	<div class="article-meta">
		<a href={ templ.URL("/@" + article.Author.Username) }>
			<img src={ avatarURL(article.Author.Image) } alt="User's profile picture"/>
		</a>
		<div class="info">
			<a href={ templ.URL("/@" + article.Author.Username) } class="author">
				{ article.Author.Username }
			</a>
			<span class="date">{ formatDate(article.CreatedAt) }</span>
		</div>
		if currentUsername == article.Author.Username {
			<a class="btn btn-sm btn-outline-secondary" href={ templ.URL("/editor/" + article.Slug) }>
				<i class="ion-edit"></i> Edit Article
			</a>
			{ " " }
			<button
				class="btn btn-sm btn-outline-danger"
				type="button"
				hx-delete={ fmt.Sprintf("/hda/articles/%s", url.PathEscape(article.Slug)) }
				hx-target="closest conduit-article-meta"
				hx-swap="outerHTML"
				data-confirm-delete="true"
			>
				<i class="ion-trash-a"></i> Delete Article
			</button>
		} else {
			if article.Author.Following {
				<button
					class="btn btn-sm btn-secondary"
					type="button"
					hx-delete={ articleMetaFollowURL(article.Author.Username, article.Slug, slot, currentUsername) }
					hx-target="closest conduit-article-meta"
					hx-swap="outerHTML"
				>
					<i class="ion-plus-round"></i> Unfollow { article.Author.Username }
				</button>
			} else {
				<button
					class="btn btn-sm btn-outline-secondary"
					type="button"
					hx-post={ articleMetaFollowURL(article.Author.Username, article.Slug, slot, currentUsername) }
					hx-target="closest conduit-article-meta"
					hx-swap="outerHTML"
				>
					<i class="ion-plus-round"></i> Follow { article.Author.Username }
				</button>
			}
			{ " " }
			if article.Favorited {
				<button
					class="btn btn-sm btn-primary"
					type="button"
					hx-delete={ articleMetaFavoriteURL(article.Slug, slot, currentUsername) }
					hx-target="closest conduit-article-meta"
					hx-swap="outerHTML"
				>
					<i class="ion-heart"></i> Favorite Article <span class="counter">({ strconv.Itoa(article.FavoritesCount) })</span>
				</button>
			} else {
				<button
					class="btn btn-sm btn-outline-primary"
					type="button"
					hx-post={ articleMetaFavoriteURL(article.Slug, slot, currentUsername) }
					hx-target="closest conduit-article-meta"
					hx-swap="outerHTML"
				>
					<i class="ion-heart"></i> Favorite Article <span class="counter">({ strconv.Itoa(article.FavoritesCount) })</span>
				</button>
			}
		}
	</div>
}

func articleMetaID(slot string) string {
	if slot == "actions" {
		return "article-meta-actions"
	}
	return "article-meta-banner"
}

func otherArticleMetaSlot(slot string) string {
	if slot == "banner" {
		return "actions"
	}
	return "banner"
}

func articleMetaFavoriteURL(slug, slot, currentUsername string) string {
	return fmt.Sprintf(
		"/hda/articles/%s/favorite?slot=%s&currentUsername=%s",
		url.PathEscape(slug),
		url.QueryEscape(slot),
		url.QueryEscape(currentUsername),
	)
}

func articleMetaFollowURL(username, articleSlug, slot, currentUsername string) string {
	return fmt.Sprintf(
		"/hda/profiles/%s/follow?articleSlug=%s&slot=%s&currentUsername=%s",
		url.PathEscape(username),
		url.QueryEscape(articleSlug),
		url.QueryEscape(slot),
		url.QueryEscape(currentUsername),
	)
}
